# ---------------------------------------------------------------------------
# Secrets — never commit these
# ---------------------------------------------------------------------------
pi-agent/auth.json
**/auth.json

# ---------------------------------------------------------------------------
# Generated / machine-local Pi state
# ---------------------------------------------------------------------------
# settings.json is rendered by ./setup.sh (via scripts/render-settings.mjs)
# from settings.core.json plus this machine's enabled optional bundles.
# Do not track it.
pi-agent/settings.json
pi-agent/.pi-setup-state.json

# Model catalogs are cached from https://pi.dev/api/models/providers/<id>
pi-agent/models-store.json
pi-agent/models.json

# Trust decisions and accumulated memory are per-machine, like the session
# history below: reported by scripts/sync.sh, never committed.
pi-agent/trust.json
pi-agent/agent-memory/

# Extension-owned per-machine config. These are rewritten at runtime
# (auto-compact by renameSync; pi-vcc and pi-web-access in place), so they must
# NOT be symlinked into the repo — see
# .trellis/spec/config/layout-and-surfaces.md. Reported by scripts/sync.sh.
# web-search.json is also pi-web-access's credential store, so it is secret-bearing.
pi-agent/auto-compact.json
pi-agent/pi-vcc-config.json
pi-agent/web-search.json
# pi-mcp-adapter's per-server tool-metadata cache, rewritten at runtime. Not
# credential-bearing — it hashes the bearer token into configHash rather than
# storing it — but it is remote content and never repo material.
pi-agent/mcp-cache.json

pi-agent/sessions/
pi-agent/npm/
# Runtime logs written by extensions into their own directory (e.g. the
# permission system's review stream) — machine-local, never committed.
pi-agent/extensions/*/logs/
pi-agent/git/
pi-agent/bin/
pi-agent/cache/
pi-agent/missions/
pi-agent/profiles/
pi-agent/run-history.jsonl
pi-agent/web-search-cache/
pi-agent/*.log
pi-agent/pi-debug.log
pi-agent/*.bak
pi-agent/*.bak-*
pi-agent/*.pre-render-*
# Extensions back up the config they rewrite *beside* it, at any depth — e.g.
# extensions/pi-permission-system/config.json.bak-<stamp> — so the top-level
# patterns above do not reach them.
pi-agent/**/*.bak-*

# ---------------------------------------------------------------------------
# Project-local Trellis adapters — regenerated by the `trellis` CLI, not tracked.
# Only the shared cross-harness core (.trellis/, AGENTS.md, .gitattributes) is kept.
# ---------------------------------------------------------------------------
.pi/
.agents/

# ---------------------------------------------------------------------------
# Editors / OS noise
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
