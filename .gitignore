# ---------------------------------------------------------------------------
# Secrets — never commit these
# ---------------------------------------------------------------------------
pi-agent/auth.json
**/auth.json

# ---------------------------------------------------------------------------
# Generated / machine-local Pi state
# ---------------------------------------------------------------------------
# settings.json is rendered by scripts/install.sh from settings.core.json
# plus this machine's enabled optional bundles. Do not track it.
pi-agent/settings.json
pi-agent/.pi-setup-state.json

# Model catalogs are cached from https://pi.dev/api/models/providers/<id>
pi-agent/models-store.json
pi-agent/models.json

pi-agent/sessions/
pi-agent/npm/
pi-agent/git/
pi-agent/bin/
pi-agent/cache/
pi-agent/*.log
pi-agent/pi-debug.log
pi-agent/*.bak
pi-agent/*.bak-*
pi-agent/*.pre-render-*

# ---------------------------------------------------------------------------
# Editors / OS noise
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
